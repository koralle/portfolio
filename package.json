{
  "name": "@koralle/portfolio",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  },
  "scripts": {
    "prepare": "panda codegen",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler pages dev",
    "astro": "astro",
    "deploy": "astro build && wrangler pages deploy",
    "cf-typegen": "wrangler types",
    "lint:check": "eslint . --config eslint.config.ts --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "lint:fix": "eslint . --config eslint.config.ts --cache  --cache-location node_modules/.cache/eslint --cache-strategy content",
    "lint:inspect": "eslint-config-inspector",
    "lint": "pnpm run lint:check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck:app": "astro check",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "run-p typecheck:*"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.2",
    "@lucide/astro": "^1.24.0",
    "astro": "7.0.7",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/ts-plugin": "^1.10.4",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@eslint/config-inspector": "^1.0.2",
    "@eslint/css": "^0.9.0",
    "@eslint/js": "^9.28.0",
    "@pandacss/dev": "^0.53.7",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^26.1.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-typegen": "^2.2.0",
    "globals": "^16.2.0",
    "jiti": "^2.4.2",
    "lefthook": "^1.11.13",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.19",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "wrangler": "^4.83.0"
  }
}
