{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Astro docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true
    },
    "chrome-devtools-mcp": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "MDN docs": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",

      "pnpm run *": "allow",

      // use `ls` instead of `eza`
      "ls *": "deny",
      "eza *": "allow",

      // use `bat` instead of `cat`
      "cat *": "deny",
      "bat *": "allow",

      // use `rg` instead of `grep`
      "grep *": "deny",
      "rg *": "allow",

      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow"
    },
    "codesearch": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "lsp": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "watcher": {
    "ignore": ["node_modules/**", ".git/**", "dist/**"]
  }
}
