---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { ContentSection } from '../components/ContentSection';
import { Footer } from '../components/Footer';
import { defaultLocale } from '../i18n/config';
import { getUi } from '../i18n/ui';

const locale = defaultLocale;
const messages = getUi(locale);
const sections = (await getCollection('home', ({ data }) => data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout locale={locale} title={messages.siteTitle} description={messages.description}>
  <Hero messages={messages} />
  {sections.map((entry) => <ContentSection entry={entry} />)}
  <Footer locale={locale} messages={messages} />
</Layout>
