---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { ContentSection } from '../components/ContentSection';
import { Footer } from '../components/Footer';
import { defaultLocale } from '../i18n/config';
import { getUi } from '../i18n/ui';

const locale = defaultLocale;
const messages = getUi(locale);
const sections = (
  await getCollection('home', ({ data }: CollectionEntry<'home'>) => data.locale === locale)
).sort((a: CollectionEntry<'home'>, b: CollectionEntry<'home'>) => a.data.order - b.data.order);
---

<Layout
  locale={locale}
  title={messages.siteTitle}
  description={messages.description}
  messages={messages}
>
  <Hero messages={messages} />
  {sections.map((entry: CollectionEntry<'home'>) => <ContentSection entry={entry} />)}
  <Footer locale={locale} messages={messages} />
</Layout>
