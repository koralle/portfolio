---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Hero } from '../../components/Hero';
import { ContentSection } from '../../components/ContentSection';
import { Footer } from '../../components/Footer';
import { locales, defaultLocale, normalizeLocale, type Locale } from '../../i18n/config';
import { getUi } from '../../i18n/ui';
import { filterProjectsByLocale, sortProjects } from '../../lib/projects';

type HomeEntry = CollectionEntry<'home'>;
type ProjectEntry = CollectionEntry<'projects'>;

export function getStaticPaths() {
  return locales
    .filter(locale => locale !== defaultLocale)
    .map(locale => ({ params: { locale }, props: { locale } }));
}

const locale = normalizeLocale(Astro.props.locale as Locale | undefined);

const messages = getUi(locale);
const sections = (
  await getCollection('home', ({ data }: HomeEntry) => data.locale === locale)
).sort((a: HomeEntry, b: HomeEntry) => a.data.order - b.data.order);
const projectEntries = sortProjects(
  filterProjectsByLocale<ProjectEntry>(await getCollection('projects'), locale)
);
---

<Layout
  locale={locale}
  title={messages.siteTitle}
  description={messages.description}
  messages={messages}
>
  <Hero messages={messages} />
  {
    sections.map((entry: HomeEntry) => (
      <ContentSection entry={entry} projects={projectEntries} messages={messages} />
    ))
  }
  <Footer locale={locale} messages={messages} />
</Layout>
