---
import { Footer as FooterView } from '../../ui/Footer';
import { localeLabels, pathForLocale, type Locale } from '../../i18n/config';
import type { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
  messages: ReturnType<typeof getUi>;
}

const { locale, messages } = Astro.props;

const locales = Object.entries(localeLabels).map(([targetLocale, label]) => ({
  href: pathForLocale(targetLocale as Locale),
  label,
  current: targetLocale === locale
}));
---

<FooterView
  languageSwitcherLabel={messages.languageSwitcherLabel}
  copyright={messages.copyright}
  locales={locales}
/>
