---
import { css } from '../../../styled-system/css';
import GitHubLogo from '../../../public/images/github-mark-white.webp';
import XLogo from '../../../public/images/x-logo-white.webp';
import { Image } from 'astro:assets';
import { localeLabels, pathForLocale, type Locale } from '../../i18n/config';
import type { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
  messages: ReturnType<typeof getUi>;
}

const { locale, messages } = Astro.props;
---

<footer
  id="footer"
  class={css({
    position: 'relative',
    display: 'grid',
    placeItems: 'center',
    width: '100svi',
    backgroundColor: 'bg.raised',
    paddingInline: { base: '16px', sm: '24px', md: '32px' },
    paddingBlock: { base: '80px', md: '96px' }
  })}
>
  <div
    class={css({
      display: 'flex',
      flexDir: 'column',
      gap: '32px'
    })}
  >
    <h1
      class={css({
        display: 'inline flex',
        justifyContent: 'center',
        alignItems: 'start',
        color: 'primary',
        fontWeight: 700,
        fontSize: {
          base: '1.5em',
          md: '2.5em',
          lg: '3em'
        }
      })}
    >
      {messages.footerHeading}
    </h1>
    <div
      class={css({
        display: 'flex',
        alignItems: 'start',
        flexDir: { base: 'column', md: 'row' },
        gap: '16px'
      })}
    >
      <a
        href="https://github.com/koralle"
        target="_blank"
        class={css({
          display: 'inline flex',
          justifyContent: 'center',
          alignItems: 'center',
          gap: '8px',
          fontWeight: 700,
          color: 'text.muted'
        })}
      >
        <Image src={GitHubLogo} alt="" width={20} height={20} decoding="async" loading="lazy" />
        GitHub
      </a>
      <a
        href="https://x.com/koralle_tech"
        target="_blank"
        class={css({
          display: 'inline flex',
          justifyContent: 'center',
          alignItems: 'center',
          gap: '8px',
          fontWeight: 700,
          color: 'text.muted'
        })}
      >
        <Image src={XLogo} alt="" width={20} height={20} decoding="async" loading="lazy" />
        X (Twitter)
      </a>
    </div>

    <nav aria-label={messages.languageSwitcherLabel} class={css({ display: 'flex', gap: '12px' })}>
      {
        Object.entries(localeLabels).map(([targetLocale, label]) => (
          <a
            href={pathForLocale(targetLocale as Locale)}
            aria-current={targetLocale === locale ? 'page' : undefined}
            class={css({
              color: targetLocale === locale ? 'primary' : 'text.muted',
              textDecoration: 'underline',
              textUnderlineOffset: '0.2em'
            })}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
  <p
    class={css({
      position: 'absolute',
      fontSize: { base: '0.75em', md: '1em' },
      bottom: { base: '12px', md: '32px' },
      color: 'text.muted'
    })}
  >
    {messages.copyright}
  </p>
</footer>
