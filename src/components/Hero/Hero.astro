---
import { css } from '../../../styled-system/css';
import { Image } from 'astro:assets';
import SleepingMugicha from '../../../public/images/sleeping-mugicha.webp';
import type { getUi } from '../../i18n/ui';

interface Props {
  messages: ReturnType<typeof getUi>;
}

const { messages } = Astro.props;
---

<section
  id="hero"
  class={css({
    position: 'relative',
    display: 'flex',
    flexDirection: 'column',
    justifyContent: { base: 'flex-start', md: 'center' },
    width: '100%',
    minHeight: '100svb',
    backgroundColor: 'bg.base',
    backgroundImage:
      'radial-gradient(ellipse 80% 60% at 75% 45%, rgba(236, 147, 161, 0.18), transparent 70%)',
    overflow: 'hidden',
    visibility: 'hidden',
    opacity: 0
  })}
>
  <div
    class={css({
      position: 'relative',
      zIndex: 1,
      display: 'flex',
      flexDirection: 'column',
      alignItems: 'flex-start',
      gap: { base: '16px', md: '20px' },
      width: '100%',
      maxWidth: { base: 'sizes.wide', md: 'min(40rem, 46svi)' },
      marginInline: 'auto',
      marginInlineStart: { md: 'max(32px, calc((100% - 1440px) / 2 + 32px))' },
      marginInlineEnd: { md: 'auto' },
      paddingInline: { base: '16px', sm: '24px', md: '32px' },
      paddingBlock: { base: '48px', md: '64px' },
      paddingBlockEnd: { base: '24px', md: '64px' }
    })}
  >
    <h1
      id="hero-brand"
      class={css({
        margin: 0,
        fontSize: 'clamp(2.5rem, 8svi, 6rem)',
        fontWeight: 700,
        lineHeight: 1.05,
        letterSpacing: '-0.02em',
        color: 'primary'
      })}
    >
      {messages.heroName}
    </h1>
    <p
      id="hero-lead"
      class={css({
        margin: 0,
        fontSize: { base: '1.25rem', md: '1.5rem', lg: '1.75rem' },
        fontWeight: 500,
        lineHeight: 1.35,
        color: 'text'
      })}
    >
      {messages.heroLead}
    </p>
    <p
      id="hero-supporting"
      class={css({
        margin: 0,
        fontSize: { base: '1rem', md: '1.125rem' },
        fontWeight: 400,
        lineHeight: 1.55,
        color: 'text.muted',
        maxWidth: '34rem'
      })}
    >
      {messages.heroSupporting}
    </p>
    <div
      id="hero-ctas"
      class={css({
        display: 'flex',
        flexWrap: 'wrap',
        gap: '12px',
        marginTop: { base: '8px', md: '12px' }
      })}
    >
      <a
        href="#projects"
        class={css({
          display: 'inline-flex',
          alignItems: 'center',
          justifyContent: 'center',
          paddingInline: '20px',
          paddingBlock: '12px',
          backgroundColor: 'primary',
          color: 'bg.base',
          fontWeight: 700,
          fontSize: '1rem',
          textDecoration: 'none',
          borderRadius: '4px',
          border: '2px solid {colors.primary}',
          _hover: { filter: 'brightness(1.05)' }
        })}
      >
        {messages.ctaProjects}
      </a>
      <a
        href="#contact"
        class={css({
          display: 'inline-flex',
          alignItems: 'center',
          justifyContent: 'center',
          paddingInline: '20px',
          paddingBlock: '12px',
          backgroundColor: 'transparent',
          color: 'text',
          fontWeight: 600,
          fontSize: '1rem',
          textDecoration: 'none',
          borderRadius: '4px',
          border: '2px solid {colors.text.muted}',
          _hover: { borderColor: 'primary', color: 'primary' }
        })}
      >
        {messages.ctaContact}
      </a>
    </div>
  </div>

  <div
    id="sleeping-mugicha"
    class={css({
      pointerEvents: 'none',
      zIndex: 0,
      // Mobile: in-flow plane below copy. Desktop: absolute right edge plane.
      position: { base: 'relative', md: 'absolute' },
      insetBlock: { md: '0' },
      insetInlineEnd: { md: '0' },
      width: { base: '100%', md: '66svi' },
      minHeight: { base: '42svb', md: '100%' },
      marginTop: { base: 'auto', md: '0' },
      display: 'grid',
      placeItems: { base: 'end center', md: 'center end' },
      '& img': {
        width: '100%',
        height: { base: 'auto', md: '100%' },
        minHeight: { md: '100%' },
        objectFit: 'contain',
        objectPosition: { base: 'center bottom', md: 'right center' }
      }
    })}
  >
    <Image src={SleepingMugicha} alt="" fetchpriority="high" loading="eager" />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const startHeroAnimation = () => {
    gsap.set('#hero', { visibility: 'visible', opacity: 1 });

    if (prefersReducedMotion) {
      return;
    }

    const splitBrand = SplitText.create('#hero-brand', {
      type: 'chars'
    });

    gsap.set(['#hero-lead', '#hero-supporting', '#hero-ctas', '#sleeping-mugicha'], {
      opacity: 0
    });

    gsap
      .timeline()
      .from(splitBrand.chars, {
        opacity: 0,
        y: 24,
        stagger: 0.04,
        duration: 0.7,
        ease: 'power2.out'
      })
      .fromTo(
        '#hero-lead',
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' },
        '-=0.25'
      )
      .fromTo(
        ['#hero-supporting', '#hero-ctas'],
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.08 },
        '-=0.2'
      )
      .fromTo(
        '#sleeping-mugicha',
        { opacity: 0, x: 40 },
        { opacity: 1, x: 0, duration: 0.85, ease: 'power2.out' },
        '-=0.25'
      );
  };

  document.addEventListener('loader-animation-finished', startHeroAnimation, {
    once: true
  });
</script>
