---
import { Hero as HeroView } from '../../ui/Hero';
import { Image } from 'astro:assets';
import SleepingMugicha from '../../../public/images/sleeping-mugicha.webp';
import type { getUi } from '../../i18n/ui';

interface Props {
  messages: ReturnType<typeof getUi>;
}

const { messages } = Astro.props;
---

<HeroView
  brand={messages.heroName}
  lead={messages.heroLead}
  supporting={messages.heroSupporting}
  ctaProjectsLabel={messages.ctaProjects}
  ctaContactLabel={messages.ctaContact}
>
  <Image src={SleepingMugicha} alt="" fetchpriority="high" loading="eager" />
</HeroView>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const startHeroAnimation = () => {
    gsap.set('#hero', { visibility: 'visible', opacity: 1 });

    if (prefersReducedMotion) {
      return;
    }

    const splitBrand = SplitText.create('#hero-brand', {
      type: 'chars'
    });

    gsap.set(['#hero-lead', '#hero-supporting', '#hero-ctas', '#sleeping-mugicha'], {
      opacity: 0
    });

    gsap
      .timeline()
      .from(splitBrand.chars, {
        opacity: 0,
        y: 24,
        stagger: 0.04,
        duration: 0.7,
        ease: 'power2.out'
      })
      .fromTo(
        '#hero-lead',
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' },
        '-=0.25'
      )
      .fromTo(
        ['#hero-supporting', '#hero-ctas'],
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.08 },
        '-=0.2'
      )
      .fromTo(
        '#sleeping-mugicha',
        { opacity: 0, x: 40 },
        { opacity: 1, x: 0, duration: 0.85, ease: 'power2.out' },
        '-=0.25'
      );
  };

  document.addEventListener('loader-animation-finished', startHeroAnimation, {
    once: true
  });
</script>
