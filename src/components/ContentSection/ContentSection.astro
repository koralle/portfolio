---
import { ContentSection as ContentSectionView } from '../../ui/ContentSection';
import { SectionHeading } from '../../ui/ContentSection';
import { render, type CollectionEntry } from 'astro:content';
import type { getUi } from '../../i18n/ui';
import { ContactLinks } from '../ContactLinks';
import { ProjectList } from '../ProjectList';

interface Props {
  entry: CollectionEntry<'home'>;
  projects?: CollectionEntry<'projects'>[];
  messages?: ReturnType<typeof getUi>;
}

const { entry, projects = [], messages } = Astro.props;
const { Content } = await render(entry);
const isProjects = entry.data.section === 'projects';
const isContact = entry.data.section === 'contact';
const tone = entry.data.tone === 'darker' ? 'darker' : 'raised';
---

<ContentSectionView id={entry.data.section} tone={tone}>
  <Content components={{ h2: SectionHeading }} />
  {
    isContact && messages && (
      <>
        <p>{messages.contactLead}</p>
        <ContactLinks />
      </>
    )
  }
  {isProjects && messages && <ProjectList projects={projects} messages={messages} />}
</ContentSectionView>
