---
import { ProjectList as ProjectListView } from '../../ui/ProjectList';
import type { CollectionEntry } from 'astro:content';
import type { getUi } from '../../i18n/ui';

interface Props {
  projects: CollectionEntry<'projects'>[];
  messages: ReturnType<typeof getUi>;
}

const { projects, messages } = Astro.props;

const items = projects.map(project => ({
  title: project.data.title,
  summary: project.data.summary,
  tags: project.data.tags,
  links: project.data.links
}));
---

<ProjectListView projects={items} emptyMessage={messages.projectsEmpty} />
