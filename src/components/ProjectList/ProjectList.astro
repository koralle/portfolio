---
import { css } from '../../../styled-system/css';
import type { CollectionEntry } from 'astro:content';
import type { getUi } from '../../i18n/ui';

interface Props {
  projects: CollectionEntry<'projects'>[];
  messages: ReturnType<typeof getUi>;
}

const { projects, messages } = Astro.props;
---

{
  projects.length === 0 ? (
    <p
      class={css({
        color: 'text.muted',
        lineHeight: 1.8,
        fontSize: { base: '1em', md: '1.125em' }
      })}
    >
      {messages.projectsEmpty}
    </p>
  ) : (
    <ul
      class={css({
        display: 'flex',
        flexDir: 'column',
        listStyle: 'none',
        margin: 0,
        padding: 0,
        width: '100%'
      })}
    >
      {projects.map(project => (
        <li
          class={css({
            display: 'flex',
            flexDir: 'column',
            gap: '8px',
            paddingBlock: '24px',
            borderBottom: '1px solid {colors.text.muted}',
            _first: { paddingTop: 0 },
            _last: { borderBottom: 'none', paddingBottom: 0 }
          })}
        >
          <h3
            class={css({
              color: 'text',
              fontSize: { base: '1.25em', md: '1.5em' },
              fontWeight: 700
            })}
          >
            {project.data.links[0] ? (
              <a
                href={project.data.links[0].href}
                class={css({
                  color: 'primary',
                  textDecoration: 'underline',
                  textUnderlineOffset: '0.2em'
                })}
              >
                {project.data.title}
              </a>
            ) : (
              project.data.title
            )}
          </h3>
          <p
            class={css({
              color: 'text.muted',
              lineHeight: 1.8,
              fontSize: { base: '1em', md: '1.125em' }
            })}
          >
            {project.data.summary}
          </p>
          {project.data.tags.length > 0 && (
            <ul
              class={css({
                display: 'flex',
                flexWrap: 'wrap',
                gap: '8px',
                listStyle: 'none',
                margin: 0,
                padding: 0
              })}
            >
              {project.data.tags.map((tag: string) => (
                <li
                  class={css({
                    color: 'text.muted',
                    fontSize: '0.875rem'
                  })}
                >
                  {tag}
                </li>
              ))}
            </ul>
          )}
          {project.data.links.length > 0 && (
            <ul
              class={css({
                display: 'flex',
                flexWrap: 'wrap',
                gap: '12px',
                listStyle: 'none',
                margin: 0,
                padding: 0
              })}
            >
              {project.data.links.map((link: { label: string; href: string }) => (
                <li>
                  <a
                    href={link.href}
                    class={css({
                      color: 'primary',
                      textDecoration: 'underline',
                      textUnderlineOffset: '0.2em',
                      fontSize: '0.875rem'
                    })}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )
}
